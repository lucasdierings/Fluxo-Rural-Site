/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/calculadora/*.jpg
  Cache-Control: public, max-age=2592000, immutable

/calculadora/styles.css
  Cache-Control: public, max-age=2592000, immutable

/calculadora/app.js
  Cache-Control: public, max-age=2592000, immutable

/images/*
  Cache-Control: public, max-age=2592000, immutable
